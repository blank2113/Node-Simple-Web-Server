{
  "compilerOptions": {
    "target": "ES2022",           
    "module": "NodeNext",         
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "outDir": "./dist",   
    "resolveJsonModule": true,        
    "rootDir": "./src",           
    "strict": true,               
    "esModuleInterop": true       
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}