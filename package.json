{
  "name": "simple-web-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "cluster:start": "npm run build && pm2 start dist/index.js --name web-server -i 2",
    "cluster:reload": "npm run build && pm2 reload web-server",
    "cluster:stop": "pm2 delete web-server",
    "cluster:status": "pm2 status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "pm2": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
